# Set by the Vercel Sanity integration automatically in Production/Preview.
# Copy this file to .env.local and fill these in for local dev.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development

# Only needed locally, only to run scripts/migrate-to-sanity.mjs. Create at
# sanity.io/manage -> your project -> API -> Tokens -> Add API token
# ("Editor" permission). Never commit this - it grants write access.
SANITY_API_TOKEN=
